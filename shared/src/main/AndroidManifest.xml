<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Receives timer/history changes from the other device (phone <-> watch). -->
        <service
            android:name="app.sequi.data.SequiSyncService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/sequi" />
            </intent-filter>
        </service>
    </application>
</manifest>
